{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.base.json", "@tsconfig/node26/tsconfig.json"],
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["*.ts", ".*.ts", "*.js", ".*.js"],
  "exclude": [
    "src/**",
    "node_modules/**",
    "src-tauri/**",
    "build/**",
    "dist-isolation/**"
  ]
}
