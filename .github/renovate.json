{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bryanforbes/renovate-presets:config-js-app.json5",
    "github>bryanforbes/renovate-presets:config-rust-default.json5"
  ],
  "rangeStrategy": "pin",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "prPriority": 5
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "JS dev dependencies (non-major)",
      "groupSlug": "js-dev-dependencies"
    },
    {
      "matchManagers": ["cargo"],
      "matchDepTypes": ["dev-dependencies", "build-dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dev and build dependencies (non-major)",
      "groupSlug": "rust-dev-build-dependencies"
    },
    {
      "extends": ["github>bryanforbes/renovate-presets:group-linters.json5"]
    },
    {
      "extends": ["github>bryanforbes/renovate-presets:group-tauri.json5"]
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["hk", "jdx/hk"],
      "groupName": "hk"
    }
  ]
}
